# apps/api — NestJS (server-only)
#
# Copy to a gitignored local file:
#   cp apps/api/.env.example apps/api/.env
#
# All variables here stay on the server. Never prefix them with NEXT_PUBLIC_.
# Do not commit `.env` or other secret-bearing files.

# Optional. HTTP listen port. Default: 3000
PORT=3000

# Optional. Runtime environment. Default when unset: development (via the process)
# NODE_ENV=development

# PostgreSQL will be the application database. Local provisioning and a
# connection variable (such as DATABASE_URL) are not configured yet.
# Current startup, lint, and tests do not need PostgreSQL.
