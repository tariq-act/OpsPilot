# apps/api — NestJS (server-only)
#
# Copy to a gitignored local file:
#   cp apps/api/.env.example apps/api/.env
#
# All variables here stay on the server. Never prefix them with NEXT_PUBLIC_.
# Do not commit `.env` or other secret-bearing files.

# Optional. HTTP listen port. Default: 3000
PORT=3000

# Optional. Runtime environment. Default when unset: development (via the process)
# NODE_ENV=development

# PostgreSQL — NestJS API only. The web app must not use these variables.
# Local Docker Compose defaults (compose.yaml). Not production secrets.
#   docker compose up -d
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_NAME=opspilot
DATABASE_USER=opspilot
DATABASE_PASSWORD=opspilot
#
# Hosted/staging (Supabase PostgreSQL): replace the values above in
# apps/api/.env with the host, port, database, user, and password from
# the Supabase dashboard (Settings → Database). Never commit those values.

# Supabase project API credentials (Settings → API). Server-only.
# Put real values in apps/api/.env. Never commit them. Never add these to apps/web.
SUPABASE_URL=
SUPABASE_ANON_KEY=
