# apps/api — NestJS (server-only)
#
# Copy to a gitignored local file:
#   cp apps/api/.env.example apps/api/.env
#
# All variables here stay on the server. Never prefix them with NEXT_PUBLIC_.
# Do not commit `.env` or other secret-bearing files.
# Never put Supabase service-role keys in this app — use a Postgres connection
# string (DATABASE_URL) only.

# Optional. HTTP listen port. Default: 3000
PORT=3000

# Optional. Serve the OpenAPI UI at /docs.
# Default: on unless NODE_ENV=production.
# SWAGGER_ENABLED=true

# Required in production. Runtime environment.
# NODE_ENV=development
# NODE_ENV=production

# PostgreSQL — NestJS API only. The web app must not use these variables.
#
# Current target: hosted Supabase PostgreSQL.
# Fill from Supabase Dashboard → Settings → Database.
# Prefer a direct or session-mode connection for this Nest process.
# Never commit real host/user/password values.
#
# Drizzle ORM and drizzle-kit read DATABASE_URL only.
#
# Example (replace placeholders; never commit real values):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL=

# Better Auth. Generate a secret with: openssl rand -base64 32
# Must be at least 32 characters. Required at boot.
BETTER_AUTH_SECRET=

# Public API origin that serves /api/auth/* (no path).
# Development default: http://localhost:3000
# Production: required, must be https (for example https://api.example.com)
BETTER_AUTH_URL=http://localhost:3000

# Browser origin allowed to call the API with credentials (apps/web).
# Must be a concrete http(s) origin. Never use * or wildcards.
# Development default: http://localhost:3001
# Production: required, must be https (for example https://app.example.com)
WEB_ORIGIN=http://localhost:3001

# Optional. Local directory for job photo binaries (FileStorage).
# Default: <cwd>/uploads
# UPLOAD_DIR=./uploads
