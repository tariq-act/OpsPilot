# apps/api — NestJS (server-only)
#
# Copy to a gitignored local file:
#   cp apps/api/.env.example apps/api/.env
#
# All variables here stay on the server. Never prefix them with NEXT_PUBLIC_.
# Do not commit `.env` or other secret-bearing files.

# Optional. HTTP listen port. Default: 3000
PORT=3000

# Optional. Serve the OpenAPI UI at /docs.
# Default: on unless NODE_ENV=production.
# SWAGGER_ENABLED=true

# Optional. Runtime environment. Default when unset: development (via the process)
# NODE_ENV=development

# PostgreSQL — NestJS API only. The web app must not use these variables.
#
# Local development: run `bun run db:up` from the repository root.
# This URL matches the defaults in compose.yaml. If you change POSTGRES_*
# in the root .env, update this URL to match (URL-encode credentials).
# Local PostgreSQL does not require SSL.
#
# Drizzle reads DATABASE_URL for the ORM and drizzle-kit.
#
# For a hosted database, replace the local URL with your private connection URL.
# Prefer a direct or session-mode connection, with SSL when required:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL=postgresql://opspilot:opspilot@127.0.0.1:5433/opspilot

# Better Auth. Generate a secret with: openssl rand -base64 32
# BETTER_AUTH_URL is the API origin that serves /api/auth/*.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Browser origin allowed to call the auth API with credentials (apps/web in
# development). Must be a concrete http(s) origin. Never use * or wildcards.
WEB_ORIGIN=http://localhost:3001

# Optional. Local directory for job photo binaries (FileStorage).
# Default: <cwd>/uploads
# UPLOAD_DIR=./uploads
