# apps/api — NestJS (server-only)
#
# Copy to a gitignored local file:
#   cp apps/api/.env.example apps/api/.env
#
# All variables here stay on the server. Never prefix them with NEXT_PUBLIC_.
# Do not commit `.env` or other secret-bearing files.

# Optional. HTTP listen port. Default: 3000
PORT=3000

# Optional. Serve the OpenAPI UI at /docs.
# Default: on unless NODE_ENV=production.
# SWAGGER_ENABLED=true

# Optional. Runtime environment. Default when unset: development (via the process)
# NODE_ENV=development

# PostgreSQL — NestJS API only. The web app must not use these variables.
#
# Current development target: hosted Supabase PostgreSQL (not local Docker).
# Fill these from Supabase Dashboard → Settings → Database.
# Prefer a direct or session-mode connection for this Nest process.
# Never commit real host/user/password values.
#
# Drizzle reads DATABASE_URL for the ORM and drizzle-kit.
#
# Example (replace placeholders; never commit real values):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL=

# Better Auth. Generate a secret with: openssl rand -base64 32
# BETTER_AUTH_URL is the API origin that serves /api/auth/*.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Browser origin allowed to call the auth API with credentials (apps/web in
# development). Must be a concrete http(s) origin. Never use * or wildcards.
WEB_ORIGIN=http://localhost:3001
