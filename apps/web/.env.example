# apps/web — Next.js
#
# Copy to a gitignored local file:
#   cp apps/web/.env.example apps/web/.env.local
#
# Next.js loads `.env*` from this directory (not the repo root).
# Prefer `.env.local` for machine-specific values.
#
# Naming:
#   NEXT_PUBLIC_*  inlined into the browser bundle — never put secrets here
#   other names    server-only (Server Components, Route Handlers, next.config)
#
# Never put DATABASE_URL, BETTER_AUTH_SECRET, or Supabase service-role keys here.

# Browser-safe API origin used by the Better Auth client and API fetch helpers.
# Development: http://localhost:3000
# Production: https://api.example.com (must match apps/api BETTER_AUTH_URL)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Public web origin for absolute metadata URLs (Open Graph, etc.).
# Development: http://localhost:3001
# Production: https://app.example.com (must match apps/api WEB_ORIGIN)
NEXT_PUBLIC_APP_URL=http://localhost:3001
