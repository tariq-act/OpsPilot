# OpsPilot workspace
#
# Runtime environment files live next to each app, not at the repo root.
# Bun, Nest, and Next.js load `.env*` from the app working directory.
#
# Setup:
#   docker compose up -d
#   cp apps/api/.env.example apps/api/.env
#   cp apps/web/.env.example apps/web/.env.local
#
# Do not put secrets in this file or in any committed example.

# Optional. Local tooling defaults to development when unset.
# NODE_ENV=development

# PostgreSQL runs via Docker Compose (compose.yaml). Override container
# name/user/password/port with a gitignored root `.env` if needed:
#   POSTGRES_DB=opspilot
#   POSTGRES_USER=opspilot
#   POSTGRES_PASSWORD=opspilot
#   POSTGRES_PORT=5432
# The API connection settings belong in apps/api/.env
# (DATABASE_HOST, DATABASE_PORT, DATABASE_NAME, DATABASE_USER,
# DATABASE_PASSWORD), not here.
