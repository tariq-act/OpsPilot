# OpsPilot workspace
#
# Runtime environment files live next to each app, not at the repo root.
# Bun, Nest, and Next.js load `.env*` from the app working directory.
#
# Setup: hosted Supabase for PostgreSQL — local Docker optional.
#   cp apps/api/.env.example apps/api/.env
#   cp apps/web/.env.example apps/web/.env.local
# Put DATABASE_URL and Better Auth values in apps/api/.env only.
#
# Production: see docs/DEPLOYMENT.md
#
# Do not put secrets in this file or in any committed example.

# Optional. Local tooling defaults to development when unset.
# NODE_ENV=development

# Local Docker Compose (compose.yaml) is optional. If you enable it, override
# container settings with a gitignored root `.env` if needed:
#   POSTGRES_DB=opspilot
#   POSTGRES_USER=opspilot
#   POSTGRES_PASSWORD=your_local_dev_password
#   POSTGRES_PORT=5432
# API connection settings always belong in apps/api/.env (DATABASE_URL).
