# OpsPilot workspace
#
# Application environment files live next to each app.
# Bun, Nest, and Next.js load `.env*` from the app working directory.
#
# Local database setup:
#   cp .env.example .env                      # optional Compose overrides
#   bun run db:up                            # start PostgreSQL and wait for health
#   cp apps/api/.env.example apps/api/.env
#   cp apps/web/.env.example apps/web/.env.local
# The API example uses the default local PostgreSQL connection.
#
# Do not put secrets in this file or in any committed example.

# Optional. Local tooling defaults to development when unset.
# NODE_ENV=development

# Local Docker Compose settings. These credentials are for local development.
# PostgreSQL is published only on 127.0.0.1, and data lives in a named volume.
POSTGRES_DB=opspilot
POSTGRES_USER=opspilot
POSTGRES_PASSWORD=opspilot
POSTGRES_PORT=5433
# Changing these values does not change credentials in an existing volume.
# API connection settings always belong in apps/api/.env
# (DATABASE_URL), not here. Keep the URL in sync with any Compose overrides.
